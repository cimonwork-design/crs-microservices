{
	"info": {
		"name": "course-service",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "CRUD (Buổi 2)",
			"item": [
				{
					"name": "Create Course",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"tenMonHoc\": \"Lập trình Java\",\n    \"soTinChi\": 3,\n    \"soChoToiDa\": 2\n}"
						},
						"url": {
							"raw": "http://localhost:8082/courses",
							"protocol": "http",
							"host": ["localhost"],
							"port": "8082",
							"path": ["courses"]
						}
					}
				},
				{
					"name": "Get Course Detail",
					"request": {
						"method": "GET",
						"url": {
							"raw": "http://localhost:8082/courses/1",
							"protocol": "http",
							"host": ["localhost"],
							"port": "8082",
							"path": ["courses", "1"]
						}
					}
				},
				{
					"name": "Update Course",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"tenMonHoc\": \"Lập trình Java nâng cao\",\n    \"soTinChi\": 4,\n    \"soChoToiDa\": 30\n}"
						},
						"url": {
							"raw": "http://localhost:8082/courses/1",
							"protocol": "http",
							"host": ["localhost"],
							"port": "8082",
							"path": ["courses", "1"]
						}
					}
				},
				{
					"name": "Delete Course",
					"request": {
						"method": "DELETE",
						"url": {
							"raw": "http://localhost:8082/courses/1",
							"protocol": "http",
							"host": ["localhost"],
							"port": "8082",
							"path": ["courses", "1"]
						}
					}
				}
			]
		},
		{
			"name": "Phân trang & Tìm kiếm (Buổi 3)",
			"item": [
				{
					"name": "Get Courses (phân trang)",
					"request": {
						"method": "GET",
						"url": {
							"raw": "http://localhost:8082/courses?page=0&size=5",
							"protocol": "http",
							"host": ["localhost"],
							"port": "8082",
							"path": ["courses"],
							"query": [
								{ "key": "page", "value": "0" },
								{ "key": "size", "value": "5" }
							]
						}
					}
				},
				{
					"name": "Search Courses (keyword)",
					"request": {
						"method": "GET",
						"url": {
							"raw": "http://localhost:8082/courses?keyword=lập trình&page=0&size=10",
							"protocol": "http",
							"host": ["localhost"],
							"port": "8082",
							"path": ["courses"],
							"query": [
								{ "key": "keyword", "value": "lập trình" },
								{ "key": "page", "value": "0" },
								{ "key": "size", "value": "10" }
							]
						}
					}
				},
				{
					"name": "Search Courses (keyword + sort)",
					"request": {
						"method": "GET",
						"url": {
							"raw": "http://localhost:8082/courses?keyword=lập trình&page=0&size=10&sort=tenMonHoc,asc",
							"protocol": "http",
							"host": ["localhost"],
							"port": "8082",
							"path": ["courses"],
							"query": [
								{ "key": "keyword", "value": "lập trình" },
								{ "key": "page", "value": "0" },
								{ "key": "size", "value": "10" },
								{ "key": "sort", "value": "tenMonHoc,asc" }
							]
						}
					}
				}
			]
		},
		{
			"name": "Internal API (Buổi 3)",
			"item": [
				{
					"name": "Reserve Seat",
					"request": {
						"method": "PATCH",
						"url": {
							"raw": "http://localhost:8082/internal/courses/1/reserve-seat",
							"protocol": "http",
							"host": ["localhost"],
							"port": "8082",
							"path": ["internal", "courses", "1", "reserve-seat"]
						}
					}
				},
				{
					"name": "Release Seat",
					"request": {
						"method": "PATCH",
						"url": {
							"raw": "http://localhost:8082/internal/courses/1/release-seat",
							"protocol": "http",
							"host": ["localhost"],
							"port": "8082",
							"path": ["internal", "courses", "1", "release-seat"]
						}
					}
				}
			]
		}
	]
}
